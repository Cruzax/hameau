# Copie ce fichier en .env puis adapte. Le .env n'est jamais versionné.

# mock (gratuit, réponses scriptées) | anthropic | ollama
LLM_PROVIDER=mock

# Garde-fous coût
LLM_MAX_CALLS_PER_DAY=40
LLM_MAX_TOKENS=1024

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Ollama (modèle local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Politique : un conseil (vote de destitution possible) tous les N jours
VOTE_EVERY_DAYS=3

# Vie du village
LIFE_ENABLED=true
MAX_POPULATION=10
