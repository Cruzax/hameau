# Copie ce fichier en .env puis adapte. Le .env n'est jamais versionné.

# Les habitants pensent avec des règles gratuites ; ces deux réglages servent seulement à l'estimation affichée.
LLM_MAX_CALLS_PER_DAY=40
LLM_MAX_TOKENS=1024

# Politique : un conseil (vote de destitution possible) tous les N jours
VOTE_EVERY_DAYS=3

# Vie du village
LIFE_ENABLED=true
MAX_POPULATION=50
